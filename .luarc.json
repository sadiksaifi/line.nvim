{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "lua/?.lua",
      "lua/?/init.lua"
    ],
    "pathStrict": true
  },
  "workspace": {
    "library": [
      "$VIMRUNTIME/lua"
    ],
    "checkThirdParty": false,
    "ignoreDir": [
      ".git"
    ]
  },
  "diagnostics": {
    "globals": [
      "vim"
    ],
    "unusedLocalExclude": [
      "_*"
    ]
  },
  "type": {
    "checkTableShape": true
  },
  "completion": {
    "callSnippet": "Replace"
  },
  "hint": {
    "enable": true
  },
  "format": {
    "enable": false
  }
}
